rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Atenção: qualquer pessoa cria conta grátis, então "logado" = "qualquer um". Nada aqui confia no app.
    function logado() { return request.auth != null; }
    // dono do app (painel de dono): pode remover obras do catálogo
    function admin() { return logado() && request.auth.token.email == 'huryelprofissional@gmail.com' && request.auth.token.email_verified == true; }
    function dono(pid) {
      return logado() && get(/databases/$(database)/documents/publicas/$(pid)).data.autorUid == request.auth.uid;
    }
    function mudou() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // Contador que só anda dentro de [min, max] por gravação (ex.: seguir = +1, deixar de seguir = -1).
    // Sem isso, qualquer conta gravava leituras = 999999999 (FB-02).
    function passo(c, min, max) {
      return !(c in mudou())
        || (request.resource.data[c] is int
            && request.resource.data[c] - resource.data.get(c, 0) >= min
            && request.resource.data[c] - resource.data.get(c, 0) <= max);
    }
    function textoAte(m, campo, max) { return !(campo in m) || (m[campo] is string && m[campo].size() <= max); }

    // obras e textos de cada pessoa (só ela vê)
    match /users/{uid}/{doc=**} {
      allow read, write: if logado() && request.auth.uid == uid;
    }

    // perfil público do autor
    match /perfis/{uid} {
      allow read: if logado();
      // o próprio dono edita o perfil, mas não infla os próprios seguidores
      allow create: if logado() && request.auth.uid == uid && request.resource.data.get('seguidores', 0) == 0;
      allow update: if logado() && passo('seguidores', -1, 1)
        && (request.auth.uid == uid || mudou().hasOnly(['seguidores']));
      allow delete: if logado() && request.auth.uid == uid;
      match /seguidores/{quem} {
        allow read: if logado();
        allow write: if logado() && request.auth.uid == quem;
      }
    }

    // catálogo público: qualquer pessoa com conta lê; só o autor escreve
    match /publicas/{pid} {
      function contadoresObraOk() {
        return passo('leituras', 1, 1) && passo('seguidores', -1, 1) && passo('somaEstrelas', -4, 5)
          && passo('numEstrelas', 0, 1) && passo('desbloqueios', 1, 1)
          // virada da semana: zera para 1 junto com uma leitura de verdade; senão, +1
          && (!('leiturasSemana' in mudou())
              || (('semanaId' in mudou()) && request.resource.data.leiturasSemana == 1 && ('leituras' in mudou()))
              || (!('semanaId' in mudou()) && passo('leiturasSemana', 1, 1)))
          // trocar a semana só junto com uma leitura de verdade (senão, zerava o ranking semanal dos outros)
          && (!('semanaId' in mudou()) || (('leituras' in mudou()) && request.resource.data.get('leiturasSemana', 0) == 1))
          && textoAte(request.resource.data, 'semanaId', 12);
      }
      allow read: if logado();
      allow create: if logado() && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.get('leituras', 0) == 0 && request.resource.data.get('seguidores', 0) == 0
        && request.resource.data.get('somaEstrelas', 0) == 0 && request.resource.data.get('numEstrelas', 0) == 0
        && request.resource.data.get('desbloqueios', 0) == 0
        && textoAte(request.resource.data, 'titulo', 200) && textoAte(request.resource.data, 'sinopse', 20000);
      allow update: if logado() && contadoresObraOk()
        && request.resource.data.autorUid == resource.data.autorUid
        && (resource.data.autorUid == request.auth.uid
            || mudou().hasOnly(['leituras', 'leiturasSemana', 'semanaId', 'seguidores', 'somaEstrelas', 'numEstrelas', 'desbloqueios']));
      allow delete: if (logado() && resource.data.autorUid == request.auth.uid) || admin();

      match /caps/{cid} {
        function reacaoOk(k) {
          return !('reacoes' in mudou()) || !(k in request.resource.data.reacoes)
            || (request.resource.data.reacoes[k] is int
                && request.resource.data.reacoes[k] - resource.data.get('reacoes', {}).get(k, 0) >= -1
                && request.resource.data.reacoes[k] - resource.data.get('reacoes', {}).get(k, 0) <= 1);
        }
        function contadoresCapOk() {
          return passo('curtidas', -1, 1) && passo('comentarios', -1, 1) && passo('leituras', 1, 1)
            && (!('reacoes' in mudou())
                || (request.resource.data.reacoes is map
                    && request.resource.data.reacoes.keys().hasOnly(['chorei', 'fogo', 'choque', 'risada', 'mente'])
                    && reacaoOk('chorei') && reacaoOk('fogo') && reacaoOk('choque') && reacaoOk('risada') && reacaoOk('mente')));
        }
        allow read: if logado();
        allow create: if dono(pid);
        allow delete: if dono(pid) || admin();
        allow update: if contadoresCapOk()
          && (dono(pid) || (logado() && mudou().hasOnly(['curtidas', 'comentarios', 'leituras', 'reacoes'])));
        match /curtidas/{uid} {
          allow read: if logado();
          allow write: if logado() && request.auth.uid == uid;
        }
        match /reacoes/{uid} {
          allow read: if logado();
          allow write: if logado() && request.auth.uid == uid
            && (request.resource == null || request.resource.data.keys().hasOnly(['r']));
        }
        match /comentarios/{id} {
          allow read: if logado();
          // só os campos que o app grava, com tamanho limitado e data no máximo 1 dia à frente (não dá para fixar no topo com data no futuro)
          allow create: if logado() && request.resource.data.uid == request.auth.uid
            && request.resource.data.keys().hasOnly(['uid', 'nome', 'texto', 'em', 'bloco', 'trecho'])
            && request.resource.data.texto is string && request.resource.data.texto.size() <= 2000
            && textoAte(request.resource.data, 'nome', 80) && textoAte(request.resource.data, 'trecho', 300)
            && request.resource.data.em is int && request.resource.data.em <= request.time.toMillis() + 86400000; // até 1 dia: celular com relógio adiantado não é recusado
          allow delete: if logado() && (resource.data.uid == request.auth.uid || dono(pid) || admin());
        }
      }
      match /textos/{t}   { allow read: if logado(); allow write: if dono(pid); allow delete: if admin(); }
      match /arquivos/{a} { allow read: if logado(); allow write: if dono(pid); allow delete: if admin(); }
      match /fichas/{f}   { allow read: if logado(); allow write: if dono(pid); allow delete: if admin(); }
      match /seguidores/{uid} { allow read: if logado(); allow write: if logado() && request.auth.uid == uid; }
      match /avaliacoes/{uid} {
        allow read: if logado();
        allow write: if logado() && request.auth.uid == uid
          && (request.resource == null
              || (request.resource.data.estrelas is int && request.resource.data.estrelas >= 1 && request.resource.data.estrelas <= 5));
      }
      // estatística de leitura: cada pessoa grava só a dela; só o autor lê
      match /leituras/{id} {
        allow read: if dono(pid);
        allow create, update: if logado() && request.resource.data.uid == request.auth.uid && id == request.resource.data.cap + '_' + request.auth.uid;
      }
    }

    // coautores e revisores (por convite)
    match /convites/{codigo} {
      // get pelo código: sim. LISTAR todos os convites: não (antes qualquer conta listava e entrava como coautor — FB-04)
      allow get: if logado();
      allow list: if false;
      allow create: if logado() && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.papel in ['COAUTOR', 'REVISOR']
        && get(/databases/$(database)/documents/colabs/$(request.resource.data.pid)).data.autorUid == request.auth.uid;
      // o autor apaga; quem acabou de entrar com o código também (convite de uso único)
      allow delete: if logado() && (resource.data.autorUid == request.auth.uid
        || exists(/databases/$(database)/documents/colabs/$(resource.data.pid)/membros/$(request.auth.uid)));
    }
    function donoColab(pid) { return logado() && get(/databases/$(database)/documents/colabs/$(pid)).data.autorUid == request.auth.uid; }
    function coautorColab(pid) { return logado() && get(/databases/$(database)/documents/colabs/$(pid)/membros/$(request.auth.uid)).data.papel == 'COAUTOR'; }
    function membroColab(pid) { return logado() && exists(/databases/$(database)/documents/colabs/$(pid)/membros/$(request.auth.uid)); }
    match /colabs/{pid} {
      allow read: if donoColab(pid) || membroColab(pid);
      // só cria a sala de colaboração de uma obra que é sua (antes dava para "ocupar" a sala de obra alheia — FB-05)
      allow create: if logado() && request.resource.data.autorUid == request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/obras/$(pid));
      allow update: if donoColab(pid) && request.resource.data.autorUid == resource.data.autorUid;
      allow delete: if donoColab(pid);
      match /membros/{uid} {
        allow read: if donoColab(pid) || membroColab(pid);
        // convite vale 7 dias e o papel é o do convite (revisor não vira coautor)
        allow create: if logado() && request.auth.uid == uid
          && get(/databases/$(database)/documents/convites/$(request.resource.data.codigo)).data.pid == pid
          && get(/databases/$(database)/documents/convites/$(request.resource.data.codigo)).data.papel == request.resource.data.papel
          && request.time.toMillis() - get(/databases/$(database)/documents/convites/$(request.resource.data.codigo)).data.criadoEm < 604800000;
        allow delete: if donoColab(pid) || (logado() && request.auth.uid == uid);
      }
      // escrever junto ao vivo: autor abre a sala; autor e coautores escrevem; revisores só leem
      match /aovivo/{cid} {
        allow read: if donoColab(pid) || membroColab(pid);
        allow write: if donoColab(pid);
        match /{sub}/{id} {
          allow read: if donoColab(pid) || membroColab(pid);
          allow write: if donoColab(pid) || coautorColab(pid);
        }
      }
      match /revisao/{cid} {
        allow read: if donoColab(pid) || membroColab(pid);
        allow write: if donoColab(pid);
        match /notas/{id} {
          allow read: if donoColab(pid) || membroColab(pid);
          allow create: if (donoColab(pid) || membroColab(pid)) && request.resource.data.uid == request.auth.uid;
          allow delete: if donoColab(pid) || (logado() && resource.data.uid == request.auth.uid);
        }
      }
      match /textos/{t} { allow read: if donoColab(pid) || membroColab(pid); allow write: if donoColab(pid); }
      match /sugestoes/{id} {
        allow read: if donoColab(pid) || membroColab(pid);
        allow create: if membroColab(pid) && request.resource.data.uid == request.auth.uid
          && get(/databases/$(database)/documents/colabs/$(pid)/membros/$(request.auth.uid)).data.papel == 'COAUTOR';
        allow delete: if donoColab(pid) || (logado() && resource.data.uid == request.auth.uid);
      }
    }
  }
}
